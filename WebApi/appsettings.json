{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },

  "AllowedHosts": "*",

  "CookieAuthOptions": {
    "LoginPath": "/login.html",
    "LogoutPath": "/",
    "AccessDeniedPath": "/forbidden",
    "ExpireTimeSpan": "02:00:00",
    "SlidingExpiration": true,
    "Cookie.HttpOnly": true
    }
}
