{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "CookieAuthOptions": {
    "LoginPath": "/loginz",
    "LogoutPath": "/",
    "AccessDeniedPath": "/forbidden",
    "ExpireTimeSpan": "02:00:00",
    "SlidingExpiration": true,
    "CookieHttpOnly": true
    }
}
